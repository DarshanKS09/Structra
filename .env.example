# ---------------------------------------------------------------------------
# Structra - Supabase environment variables
#
# Copy this file to `.env.local` for development:
#     cp .env.example .env.local
#
# `.env.local` and every other `.env*` file except `.env.example` are
# already ignored by .gitignore. Never commit real credentials.
#
# Find these values in your Supabase Dashboard:
#     Project Settings -> API
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# 1. Project URL
#
# REQUIRED. Public. Safe to expose to the browser - this value is embedded
# in the client bundle by design.
# Format: https://<project-ref>.supabase.co
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=

# ---------------------------------------------------------------------------
# 2. Publishable / anonymous key
#
# REQUIRED. Public. Designed to be shipped to the browser. Access is gated by
# Row Level Security policies, which are configured in a later phase.
#
# Use the new publishable key (`sb_publishable_...`) or, on older projects, the
# legacy `anon` JWT. Do NOT use the service_role key here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# 3. Service role key
#
# OPTIONAL - server-only. Grants full access bypassing Row Level Security.
# Only required for privileged server operations (admin listing, migrations,
# webhooks). Never reference it from a `NEXT_PUBLIC_*` variable or from any
# file that a client component can import.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Notes for the next phase (database / auth)
# ---------------------------------------------------------------------------
# * Schema types live in `lib/supabase/types.ts` and can be regenerated with:
#       npx supabase gen types typescript --project-id <project-ref> \
#         > lib/supabase/types.ts
#
# * Existing application behaviour is untouched: Structra still reads and
#   writes its Zustand/localStorage state exactly as before. This step only
#   establishes the Supabase client layer.


# ===========================================================================
# REGISTRATION OTP
#
# Registration verifies an email address with a 6-digit code before the
# Supabase Auth account is created. The code is generated on the server, stored
# only as an HMAC digest, and emailed through Brevo.
# ===========================================================================

# ---------------------------------------------------------------------------
# 4. OTP pepper
#
# REQUIRED. Server-only. At least 32 characters.
#
# This key is what makes a stolen code digest useless. A six-digit code has only
# ~1,000,000 possible values, so a plain hash could be brute-forced instantly;
# HMAC keyed with this secret cannot be. If it ever leaks, every stored digest
# must be discarded (all challenges expire within 10 minutes anyway).
#
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ROTATING IT invalidates every outstanding challenge, which is the desired
# behaviour in a compromise.
# ---------------------------------------------------------------------------
OTP_PEPPER=


# ===========================================================================
# BREVO (transactional email)
#
# Brevo is used for delivery ONLY. It is not an authentication provider -
# identity, sessions and passwords all remain Supabase Auth's responsibility.
# ===========================================================================

# ---------------------------------------------------------------------------
# 5. Brevo SMTP relay
#
# Delivery uses Brevo's SMTP relay rather than its HTTPS API. All of the
# following are SERVER-ONLY; none may be exposed to the browser.
#
# Optional in development: with no login/password set, registration emails are
# printed to the server console instead. That fallback is hard-disabled in
# production, so a missing value can never mean "log the OTP".
# ---------------------------------------------------------------------------

# Relay host and port. 587 uses STARTTLS; 465 negotiates TLS implicitly.
# Both default to the values below if unset.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587

# SMTP credentials from Brevo -> SMTP & API -> SMTP.
# BREVO_SMTP_LOGIN is the account login (usually the account email).
# BREVO_SMTP_PASSWORD is the generated SMTP key - this is a DIFFERENT secret
# from the HTTPS API key.
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=

# Connection, greeting, socket and handshake timeout. Defaults to 10 seconds.
BREVO_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# 6. Sender identity
#
# SERVER ONLY. Must be a sender verified in your Brevo account, otherwise the
# relay accepts the connection but rejects the message (550/553).
# ---------------------------------------------------------------------------
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Structra


# ---------------------------------------------------------------------------
# Applying the registration migration
#
# The OTP challenge table is created by a version-controlled migration and MUST
# be applied before registration will work:
#
#   npx supabase login
#   npx supabase link --project-ref <project-ref>
#   npx supabase db push
#
# Do not create the table through the dashboard - that would leave the migration
# history out of step with the database.